# Turso credentials: create a DB, then copy its URL and auth token here.
TURSO_DATABASE_URL = "libsql://YOUR-DATABASE-YOUR-ORG.turso.io"
TURSO_AUTH_TOKEN = "YOUR_TURSO_AUTH_TOKEN"

# First trainer account is created once, when the app initializes.
TRAINER_USERNAME = "trainer"
TRAINER_PASSWORD = "Replace-With-A-Long-Unique-Password-At-Least-14-Chars"

# Optional trainer details for the welcome screen.
TRAINER_NAME = "Your Trainer Name"
TRAINER_TITLE = "Certified Personal Trainer"
TRAINER_EXPERIENCE = "5+ years"
TRAINER_ACHIEVEMENTS = "Certified Fitness Coach;Strength & Conditioning"

# Optional session policy
SESSION_IDLE_MINUTES = 60
LOGIN_MAX_FAILURES = 5
LOGIN_LOCK_MINUTES = 15
